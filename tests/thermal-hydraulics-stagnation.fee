DEFAULT_ARGUMENT_VALUE 1 "p0=1.005e6 T0=400"
DEFAULT_ARGUMENT_VALUE 2 inlet
DEFAULT_ARGUMENT_VALUE 3 relap7-two-pipes.msh
PROBLEM thermal_hydraulics MESH $3
MATERIAL pipe1 A=0.785398163e-4 D_h=0.01 f=0.01
MATERIAL pipe2 A=0.785398163e-4 D_h=0.01 f=0.01
BC $2 $1
BC outlet p=1e6 T=300
SOLVE_PROBLEM
PRINT abs((p(0,0,0)+rho(0,0,0)*v(0,0,0)^2/2)/1.005e6-1)+abs((h(0,0,0)+v(0,0,0)^2/2)/533466.6946390772-1)+abs(mdot(1,0,0)/mdot(0,0,0)-1)
