# RELAP-7 Example 8: ideal pump, IF97, low-Mach junctions, backward Euler.
# The insulated circulating fluid warms from the hydraulic pump power.
DEFAULT_ARGUMENT_VALUE 1 relap7-pump-loop.msh
DEFAULT_ARGUMENT_VALUE 2 1
PROBLEM thermal_hydraulics DIM 2 MESH $1
p_0(x,y) = 1e5
T_0(x,y) = 300
v_0(x,y) = 0
end_time = 10
dt = 0.1
MATERIAL pipe1 A=0.785398163e-4 D_h=0.01 f=0.01
MATERIAL pipe2 A=3.14159e-4 D_h=0.01 f=0.01
MATERIAL pipe3 A=0.785398163e-4 D_h=0.01 f=0.01
MATERIAL pipe4 A=3.14159e-4 D_h=0.01 f=0.01
MATERIAL pipe5 A=0.785398163e-4 D_h=0.01 f=0.01
PUMP POINT pump HEAD 1 DIRECTION 1 1 0 K_REVERSE 10 10 A_REF 0.785398163e-3
JUNCTION POINT junction2 K=3 A_ref=0.785398163e-3
JUNCTION POINT junction3 K=3 A_ref=0.785398163e-3
JUNCTION POINT junction4 K=3 A_ref=0.785398163e-3
BC outlet p=1e5
SOLVE_PROBLEM
IF done&$2
  PRINT mdot(0.5,0) mdot(1,0.5) mdot(0.5,1) mdot(0,0.5) mdot(1,1.25) T(0.5,0)
ENDIF
