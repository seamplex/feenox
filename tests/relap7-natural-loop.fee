# RELAP-7 Example 10, IF97 water at elevated pressure to remain single phase.
# The core is an equivalent fuel-clad bundle; the secondary is counterflow.
# The wall retains the manual's depth=1 and explicit bundle interface perimeters.
DEFAULT_ARGUMENT_VALUE 1 relap7-natural-loop.msh
DEFAULT_ARGUMENT_VALUE 2 50
DEFAULT_ARGUMENT_VALUE 3 1
DEFAULT_ARGUMENT_VALUE 4 1
DEFAULT_ARGUMENT_VALUE 5 15.5e6
DEFAULT_ARGUMENT_VALUE 6 1
PROBLEM thermal_hydraulics DIM 3 MESH $1
end_time = $2
dt = 0.1
g_z = -9.80665
p_0(x,y,z) = $5
T_0(x,y,z) = 300.15
v_0(x,y,z) = $4
T_solid_0(r,x,y,z) = 300.15
MATERIAL piping {
  LABEL pipe1 LABEL pipe2 LABEL pipe3 LABEL pipe4 LABEL pipe6
  A=0.44934 D_h=0.002972 f=0.001
}
MATERIAL pipe5 A=0.44934 D_h=0.002972 f=10
MATERIAL primary A=0.44934 D_h=0.0186 f=0.022
MATERIAL secondary A=0.44934 D_h=0.014 f=0.022
MATERIAL fuel k=29.3 rho_s=1.4583e4 cp=191.67
MATERIAL clad k=26.3 rho_s=7.646e3 cp=638
MATERIAL wall k=26.3 rho_s=7.646e3 cp=638
MATERIAL core {
  A=0.44934 D_h=0.002972 f=0.022 h_wall=1.6129e5
  fuel_radius=0.00348 fuel_cells=4 clad_width=0.00052 clad_cells=1
  rod_count=497.778852/(2*pi*0.004) hs_power=5.1296e7
}
HEAT_STRUCTURE PIPE core FUEL fuel CLAD clad
HEAT_STRUCTURE NAME exchanger {
  TYPE PLATE MATERIAL wall THICKNESS 0.0044 CELLS 2 DEPTH 1
  PRIMARY primary SECONDARY secondary H_PRIMARY 1.6129e5 H_SECONDARY 1.6129e5
  PERIMETER_PRIMARY 327.56886 PERIMETER_SECONDARY 327.56886
  AXIS 0 0 1
}
JUNCTION POINT junction1 K=0.5 A_ref=0.44934
JUNCTION POINT junction2 K=0.5 A_ref=0.44934
JUNCTION POINT junction3 K=0 A_ref=0.44934
JUNCTION POINT junction4 K=0.1 A_ref=0.44934
JUNCTION POINT junction5 K=0 A_ref=0.44934
JUNCTION POINT junction6 K=0 A_ref=0.44934
JUNCTION POINT junction7 K=0 A_ref=0.44934
BC inlet mdot=223.77 T=300.15
BC outlet p=$5
# Reversible pressure-control connection to a reservoir at the initial temperature.
BC pressure_control p=$5 T=300.15
SOLVE_PROBLEM
IF done&$3
  PRINT mdot(0,0,0.4) T(0,0,0.8) T(0,1,2.27) T(0,1.2,5.98) hs_heat_core hs_heat_secondary_exchanger
ENDIF
