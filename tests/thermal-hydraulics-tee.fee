# two streams of water at different temperatures mixing in a tee
PROBLEM thermal_hydraulics DIM 2 MESH thermal-hydraulics-tee.msh

MATERIAL branch D=0.02 roughness=1e-5
MATERIAL main   D=0.03 roughness=1e-5

BC in1 mdot=1 T=300
BC in2 mdot=2 T=350
BC out p=1e6

SOLVE_PROBLEM

# mass conservation and adiabatic mixing
PRINT abs(mdot(3,0.5)-3)+abs(h(3,0.5)/((h(0,0)+2*h(0,1))/3)-1)
