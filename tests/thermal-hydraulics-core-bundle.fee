DEFAULT_ARGUMENT_VALUE 1 1
DEFAULT_ARGUMENT_VALUE 2 0
PROBLEM thermal_hydraulics DIM 3 MESH relap7-core-channel.msh
end_time = $2
dt = 0.1
p_0(x,y,z) = 15.5e6
T_0(x,y,z) = 300
v_0(x,y,z) = 1
T_solid_0(r,x,y,z) = 300
MATERIAL fuel k=29.3 rho_s=14583 cp=191.67
MATERIAL clad k=26.3 rho_s=7646 cp=638
MATERIAL channel {
  A=0.44934 D_h=0.002972 f=0.022 h_wall=1.6129e5
  fuel_radius=0.00348 fuel_cells=40 clad_width=0.00052 clad_cells=10
  rod_count=$1 hs_power=$1*1000
}
HEAT_STRUCTURE PIPE channel FUEL fuel CLAD clad NO_AXIAL_CONDUCTION
BC inlet mdot=$1*0.1 T=300
BC outlet p=15.5e6
SOLVE_PROBLEM
VAR old_energy
IF in_static
  initial_energy = hs_energy_channel
ELSE
  energy_error = max(energy_error,abs((hs_energy_channel-old_energy)/dt+hs_heat_channel-$1*1000)/($1*1000))
ENDIF
old_energy = hs_energy_channel
IF end_time=0
  linear_heat = 1000/3.865
  fuel_drop = linear_heat/(4*pi*29.3)
  clad_drop = linear_heat/(2*pi*26.3)*log(0.004/0.00348)
  convection_drop = linear_heat/(1.6129e5*2*pi*0.004)
  PRINT abs(hs_heat_channel/($1*1000)-1)+abs((T_fuel_center(0,0,3.865)-T_fuel_surface(0,0,3.865))/fuel_drop-1)+abs((T_fuel_surface(0,0,3.865)-T_clad_surface(0,0,3.865))/clad_drop-1)+abs((T_clad_surface(0,0,3.865)-T(0,0,3.865))/convection_drop-1)
ENDIF
IF done&end_time>0
  expected_energy = $1*3.865*pi*(0.00348^2*14583*191.67+(0.004^2-0.00348^2)*7646*638)*300
  PRINT energy_error+abs(initial_energy/expected_energy-1)
ENDIF
