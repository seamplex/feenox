DEFAULT_ARGUMENT_VALUE 1 "PUMP POINT connection HEAD 1 DIRECTION 1 0 0"
DEFAULT_ARGUMENT_VALUE 2 "dummy=0"
DEFAULT_ARGUMENT_VALUE 3 relap7-two-pipes.msh
DEFAULT_ARGUMENT_VALUE 4 1
PROBLEM thermal_hydraulics DIM $4 MESH $3
MATERIAL pipe1 A=1 f=0.01
MATERIAL pipe2 A=1 f=0.01
BC inlet mdot=1000 T=300
BC outlet p=1e5 T=300
$1
$2
SOLVE_PROBLEM
