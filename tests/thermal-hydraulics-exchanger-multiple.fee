DEFAULT_ARGUMENT_VALUE 1 "TYPE PLATE THICKNESS 0.01 CELLS 2 DEPTH 0.5"
DEFAULT_ARGUMENT_VALUE 2 relap7-heat-exchanger.msh
DEFAULT_ARGUMENT_VALUE 3 "H_PRIMARY 1e4 H_SECONDARY 1e4"
DEFAULT_ARGUMENT_VALUE 4 "k=100 rho_s=100 cp=100"
DEFAULT_ARGUMENT_VALUE 5 0
DEFAULT_ARGUMENT_VALUE 6 "HEAT_STRUCTURE NAME second TYPE PLATE THICKNESS 0.01 CELLS 2 DEPTH 0.5 MATERIAL wall PRIMARY primary SECONDARY secondary H_PRIMARY 1e4 H_SECONDARY 1e4 AXIS 1 0 0"
INCLUDE thermal-hydraulics-exchanger-setup.fee
PRINT abs(T_wall_primary_exchanger(0.5,0.02)-T_wall_primary_second(0.5,0.02))+abs(T_wall_secondary_exchanger(0.5,0)-T_wall_secondary_second(0.5,0))+abs(hs_energy_exchanger/hs_energy_second-1)+abs(hs_heat_primary_exchanger/hs_heat_primary_second-1)
WRITE_RESULTS FILE thermal-hydraulics-exchanger.vtu all
